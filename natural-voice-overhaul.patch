+// Functional smoke test for the v2 natural-voice engines.
+// Run: node --experimental-loader ./tests/alias-loader.mjs tests/voice-smoke.mts
+//
+// Web Audio is browser-only, so this test stubs OfflineAudioContext with a
+// deterministic recorder: automation curves are validated (finite, length>=2)
+// and the raw glottal source is analyzed numerically (F0, jitter, shimmer).
+
+let failures = 0;
+function check(name: string, ok: boolean, evidence = ''): void {
+  if (ok) console.log(`ok   - ${name}`);
+  else { failures++; console.log(`FAIL - ${name}${evidence ? '  [' + evidence + ']' : ''}`); }
+}
+
+// ---------- minimal OfflineAudioContext stub ----------
+class FakeParam {
+  value: number;
+  constructor(value = 1) { this.value = value; }
+  setValueAtTime(v: number) { this.value = v; return this; }
+  linearRampToValueAtTime() { return this; }
+  exponentialRampToValueAtTime() { return this; }
+  setTargetAtTime() { return this; }
+  cancelScheduledValues() { return this; }
+  setValueCurveAtTime(curve: Float32Array, _t: number, dur: number) {
+    if (!curve || curve.length < 2) throw new Error('automation curve too short');
+    for (const v of curve) {
+      if (!Number.isFinite(v)) throw new Error('non-finite automation value');
+    }
+    if (!(dur > 0)) throw new Error('non-positive automation duration');
+    return this;
+  }
+}
+
+class FakeNode {
+  type = '';
+  gain = new FakeParam(1);
+  frequency = new FakeParam(350);
+  Q = new FakeParam(1);
+  detune = new FakeParam(0);
+  curve: Float32Array | null = null;
+  oversample = 'none';
+  buffer: unknown = null;
+  loop = false;
+  connect(_n: FakeNode) { return _n; }
+  start() {}
+  stop() {}
+  setPeriodicWave() {}
+}
+
+class FakeBuffer {
+  numberOfChannels: number;
+  length: number;
+  sampleRate: number;
+  duration = 0;
+  data: Float32Array[] = [];
+  constructor(numberOfChannels: number, length: number, sampleRate: number) {
+    this.numberOfChannels = numberOfChannels;
+    this.length = length;
+    this.sampleRate = sampleRate;
+  }
+  getChannelData(c: number): Float32Array {
+    if (!this.data[c]) this.data[c] = new Float32Array(this.length);
+    return this.data[c];
+  }
+  copyFrom(b: FakeBuffer) { for (let c = 0; c < this.numberOfChannels; c++) this.getChannelData(c).set(b.getChannelData(Math.min(c, b.numberOfChannels - 1))); }
+}
+
+class FakeOfflineAudioContext {
+  static lastRendered: FakeBuffer | null = null;
+  numberOfChannels: number;
+  length: number;
+  sampleRate: number;
+  destination: FakeNode;
+  currentTime: number;
+  constructor(numberOfChannels: number, length: number, sampleRate: number) {
+    this.numberOfChannels = numberOfChannels;
+    this.length = length;
+    this.sampleRate = sampleRate;
+    this.destination = new FakeNode();
+    this.currentTime = 0;
+  }
+  createGain() { return new FakeNode(); }
+  createBiquadFilter() { const n = new FakeNode(); n.type = 'bandpass'; return n; }
+  createWaveShaper() { const n = new FakeNode(); return n; }
+  createBufferSource() { const n = new FakeNode(); return n; }
