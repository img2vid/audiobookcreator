+    const descriptor = bytes(16), dv = new DataView(descriptor.buffer);
+    dv.setUint32(0, 0x08074b50, true); dv.setUint32(4, crc, true);
+    dv.setUint32(8, blob.size, true); dv.setUint32(12, blob.size, true); yield emit(descriptor);
