diff --git a/src/lib/engines/book-db.ts b/src/lib/engines/book-db.ts
new file mode 100644
index 0000000000000000000000000000000000000000..83c8e82bc29a7411a586e5a5af76cc653aedb2fa
--- /dev/null
+++ b/src/lib/engines/book-db.ts
@@ -0,0 +1,106 @@
+import type { BookProject } from './book-plan';
+
+export interface BookChunk {
+  id: string; projectId: string; chapterId: string; index: number; signature: string;
+  pcm: Blob; frames: number; sampleRate: number; engineLabel: string;
+}
+export type BookChunkInfo = Omit<BookChunk, 'pcm'>;
+const DB = 'openmukti-book-desk';
+let opening: Promise<IDBDatabase> | undefined;
+
+function database(): Promise<IDBDatabase> {
+  if (opening) return opening;
+  opening = new Promise<IDBDatabase>((resolve, reject) => {
+    if (!globalThis.indexedDB) { reject(new Error('Local storage is unavailable. Enable IndexedDB or use a regular browser window.')); return; }
+    const req = indexedDB.open(DB, 1);
+    req.onupgradeneeded = () => {
+      const db = req.result;
+      db.createObjectStore('projects', { keyPath: 'id' });
+      const chunks = db.createObjectStore('chunks', { keyPath: 'id' });
+      chunks.createIndex('projectId', 'projectId');
+      chunks.createIndex('chapterId', 'chapterId');
+      db.createObjectStore('leases', { keyPath: 'id' });
+    };
+    req.onsuccess = () => {
+      req.result.onversionchange = () => { req.result.close(); opening = undefined; };
+      resolve(req.result);
+    };
+    req.onblocked = () => reject(new Error('Close other Audiobook Creator tabs to upgrade local storage.'));
+    req.onerror = () => reject(req.error ?? new Error('Could not open local storage'));
+  }).catch(err => { opening = undefined; throw err; });
+  return opening;
+}
+
+async function transaction<T>(stores: string[], mode: IDBTransactionMode, work: (tx: IDBTransaction, set: (value: T) => void) => void): Promise<T> {
+  const db = await database();
+  return new Promise<T>((resolve, reject) => {
+    const tx = db.transaction(stores, mode);
+    let value: T;
+    tx.oncomplete = () => resolve(value);
+    tx.onerror = tx.onabort = () => reject(new Error(tx.error?.name === 'QuotaExceededError'
+      ? 'Local disk quota is full. Download completed parts, then delete an old project to free space.'
+      : tx.error?.message ?? 'Local storage transaction failed'));
+    try { work(tx, v => { value = v; }); }
+    catch (err) { tx.abort(); reject(err); }
+  });
+}
+
+export async function saveBook(project: BookProject): Promise<void> {
+  return transaction(['projects', 'leases'], 'readwrite', tx => {
+    const lock = tx.objectStore('leases').get(project.id);
+    lock.onsuccess = () => {
+      if (lock.result?.expires > Date.now()) { tx.abort(); return; }
+      tx.objectStore('projects').put(project);
+    };
+  });
+}
+
+export const listBooks = () => transaction<BookProject[]>(['projects'], 'readonly', (tx, set) => {
+  const req = tx.objectStore('projects').getAll();
+  req.onsuccess = () => set((req.result as BookProject[]).sort((a, b) => b.updatedAt - a.updatedAt));
+});
+export const getBook = (id: string) => transaction<BookProject | undefined>(['projects'], 'readonly', (tx, set) => {
+  const req = tx.objectStore('projects').get(id); req.onsuccess = () => set(req.result);
+});
+export const getBookChunk = (id: string) => transaction<BookChunk | undefined>(['chunks'], 'readonly', (tx, set) => {
+  const req = tx.objectStore('chunks').get(id); req.onsuccess = () => set(req.result);
+});
+export const putBookChunk = (chunk: BookChunk) => transaction<void>(['chunks'], 'readwrite', tx => { tx.objectStore('chunks').put(chunk); });
+export const bookChunkId = (p: string, c: string, i: number) => `${p}/${c}/${i}`;
+export const chapterChunks = (chapterId: string) => transaction<BookChunk[]>(['chunks'], 'readonly', (tx, set) => {
+  const req = tx.objectStore('chunks').index('chapterId').getAll(chapterId);
+  req.onsuccess = () => set((req.result as BookChunk[]).sort((a, b) => a.index - b.index));
+});
+export const bookChunkInfo = (projectId: string) => transaction<BookChunkInfo[]>(['chunks'], 'readonly', (tx, set) => {
+  const out: BookChunkInfo[] = [];
+  const req = tx.objectStore('chunks').index('projectId').openCursor(projectId);
+  req.onsuccess = () => {
+    const cur = req.result;
+    if (!cur) { set(out); return; }
+    const { pcm, ...meta } = cur.value as BookChunk;
+    out.push(meta); cur.continue();
+  };
+});
+export const deleteBook = (projectId: string) => transaction<void>(['projects', 'chunks', 'leases'], 'readwrite', tx => {
+  const lease = tx.objectStore('leases').get(projectId);
+  lease.onsuccess = () => {
+    if (lease.result?.expires > Date.now()) { tx.abort(); return; }
+    tx.objectStore('projects').delete(projectId);
+    const req = tx.objectStore('chunks').index('projectId').openCursor(projectId);
+    req.onsuccess = () => { const cur = req.result; if (cur) { cur.delete(); cur.continue(); } };
+    tx.objectStore('leases').delete(projectId);
+  };
+});
+
+/** Atomic cross-tab lease also works in browsers without the Web Locks API. */
+export const claimBook = (id: string, owner: string) => transaction<boolean>(['leases'], 'readwrite', (tx, set) => {
+  const store = tx.objectStore('leases'), req = store.get(id);
+  req.onsuccess = () => {
+    if (req.result?.expires > Date.now() && req.result.owner !== owner) { set(false); return; }
+    store.put({ id, owner, expires: Date.now() + 120_000 }); set(true);
+  };
+});
+export const releaseBook = (id: string, owner: string) => transaction<void>(['leases'], 'readwrite', tx => {
+  const store = tx.objectStore('leases'), req = store.get(id);
+  req.onsuccess = () => { if (req.result?.owner === owner) store.delete(id); };
+});
diff --git a/src/lib/engines/book-export.ts b/src/lib/engines/book-export.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4c47c4e30aabeb1bb43108f19720defa68706f99
--- /dev/null
+++ b/src/lib/engines/book-export.ts
@@ -0,0 +1,78 @@
+import { chapterChunks } from './book-db';
+import { renderSignature, safeBookName, splitBookText, vttTime, wavHeader, type BookProject } from './book-plan';
+import { zipFiles, type ZipSource } from './zip-write';
+
+export async function chapterAudio(project: BookProject, chapterId: string): Promise<{ blob: Blob; vtt: string; duration: number; name: string }> {
+  const chapter = project.chapters.find(c => c.id === chapterId);
+  if (!chapter) throw new Error('Chapter not found');
+  const plan = splitBookText(chapter.text, project.chunkChars).filter(t => t.trim());
+  const records = await chapterChunks(chapterId);
+  if (!plan.length) throw new Error('This chapter is empty');
+  const chunks = plan.map((text, index) => {
+    const found = records.find(c => c.index === index && c.signature === renderSignature(project, text));
+    if (!found) throw new Error('Render this chapter first. Some chunks are missing or were changed.');
+    if (found.sampleRate !== 22050 || found.pcm.size !== found.frames * 2) throw new Error('Invalid saved audio. Render this chapter again.');
+    return found;
+  });
+  let duration = 0;
+  const vtt = ['WEBVTT', '', 'NOTE Captions align to rendered chunks, not individual words.', ''];
+  chunks.forEach((c, i) => {
+    const start = duration; duration += c.frames / c.sampleRate;
+    vtt.push(String(i + 1), `${vttTime(start)} --> ${vttTime(duration)}`, plan[i].trim().replace(/-->/g, '→').replace(/\n\s*\n/g, '\n').replace(/&/g, '&amp;').replace(/</g, '&lt;'), '');
+  });
+  const size = chunks.reduce((n, c) => n + c.pcm.size, 0);
+  const blob = new Blob([wavHeader(size) as BlobPart, ...chunks.map(c => c.pcm)], { type: 'audio/wav' });
+  const number = String(project.chapters.indexOf(chapter) + 1).padStart(4, '0');
+  return { blob, duration, vtt: vtt.join('\n'), name: `${number}-${safeBookName(chapter.title)}` };
+}
+
+export async function* bookPackage(project: BookProject): AsyncGenerator<Uint8Array> {
+  async function* sources(): AsyncGenerator<ZipSource> {
+    yield { name: 'project.json', blob: new Blob([JSON.stringify(project, null, 2)], { type: 'application/json' }) };
+    const playlist = ['#EXTM3U'];
+    const manifest = { title: project.title, author: project.author, language: project.language,
+      format: 'WAV PCM 16-bit mono 22050 Hz', chapters: [] as { title: string; file: string; duration: number }[] };
+    for (const chapter of project.chapters) {
+      if (!chapter.text.trim()) continue;
+      const audio = await chapterAudio(project, chapter.id);
+      yield { name: `${audio.name}.wav`, blob: audio.blob };
+      yield { name: `${audio.name}.vtt`, blob: new Blob([audio.vtt], { type: 'text/vtt' }) };
+      yield { name: `${audio.name}.txt`, blob: new Blob([chapter.text], { type: 'text/plain;charset=utf-8' }) };
+      playlist.push(`#EXTINF:${audio.duration.toFixed(3)},${chapter.title.replace(/[\r\n]/g, ' ')}`, `${audio.name}.wav`);
+      manifest.chapters.push({ title: chapter.title, file: `${audio.name}.wav`, duration: audio.duration });
+    }
+    yield { name: 'playlist.m3u8', blob: new Blob([playlist.join('\n')], { type: 'audio/x-mpegurl' }) };
+    yield { name: 'chapters.json', blob: new Blob([JSON.stringify(manifest, null, 2)], { type: 'application/json' }) };
+  }
+  yield* zipFiles(sources());
+}
+
+export function downloadBookBlob(blob: Blob, name: string): void {
+  const url = URL.createObjectURL(blob), a = document.createElement('a');
+  a.href = url; a.download = name; document.body.append(a); a.click(); a.remove();
+  // Keep the URL alive long enough for Safari's download handoff.
+  setTimeout(() => URL.revokeObjectURL(url), 60_000);
+}
+
+interface FileSink { write: (data: Uint8Array) => Promise<void>; close: () => Promise<void>; abort: () => Promise<void> }
+export async function exportBookPackage(project: BookProject, onBytes: (n: number) => void): Promise<void> {
+  const name = `${safeBookName(project.title)}.zip`;
+  const picker = (window as unknown as { showSaveFilePicker?: (opts: unknown) => Promise<{ createWritable: () => Promise<FileSink> }> }).showSaveFilePicker;
+  // Must invoke the picker directly in the click gesture, before reading IndexedDB.
+  const sink = picker ? await (await picker({ suggestedName: name, types: [{ description: 'Audiobook ZIP', accept: { 'application/zip': ['.zip'] } }] })).createWritable() : undefined;
+  const parts: BlobPart[] = [];
+  let size = 0;
+  try {
+    for await (const bytes of bookPackage(project)) {
+      size += bytes.length;
+      if (sink) await sink.write(bytes);
+      else {
+        if (size > 128 * 1024 * 1024) throw new Error('This browser needs an in-memory ZIP. The 128 MB safety limit was reached. Download individual chapter WAVs, or use a browser with Save File support.');
+        parts.push(bytes as BlobPart);
+      }
+      onBytes(size);
+    }
+    if (sink) await sink.close();
+    else downloadBookBlob(new Blob(parts, { type: 'application/zip' }), name);
+  } catch (err) { if (sink) await sink.abort().catch(() => {}); throw err; }
+}
diff --git a/src/lib/engines/book-plan.ts b/src/lib/engines/book-plan.ts
